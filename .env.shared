# Shared env schema for varlock (imported by app schemas)
# @currentEnv=$APP_ENV
# @defaultSensitive=false @defaultRequired=false
# ---

# Environment flag
# @type=enum(development, staging, production, test) @required
APP_ENV=development

# Port configurations
# @type=port @required=forEnv(development)
FRONTEND_PORT=5173
# @type=port @required
BACKEND_PORT=3000

# Shared URLs (derived from APP_ENV)
# @required
BACKEND_URL=ifs(
  forEnv(development, test), "http://localhost:${BACKEND_PORT}",
  forEnv(staging), "https://api.stg.skills.melvyn.be",
  forEnv(production), "https://api.skills.melvyn.be",
  undefined
)
# @required
FRONTEND_URL=ifs(
  forEnv(development, test), "http://localhost:${FRONTEND_PORT}",
  forEnv(staging), "https://stg.skills.melvyn.be",
  forEnv(production), "https://skills.melvyn.be",
  undefined
)
