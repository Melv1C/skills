# @import(../../.env.shared)
# @defaultSensitive=true @defaultRequired=true
# @generateTypes(lang=ts, path=env.d.ts)
# ---

# @type=string @sensitive=false
NODE_ENV=$APP_ENV

# Database
# @type=url
DATABASE_URL=if(
  forEnv(development), postgresql://postgres:postgres@localhost:5432/postgres, 
  undefined
)

# BetterAuth
# @type=string(minLength=32)
# @docs(https://better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=if(
  forEnv(development, test), your_secret_key_here_of_at_least_32_characters,
  undefined
)

# @type=url @sensitive=false
# @docs(https://better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_URL=$BACKEND_URL

# Object storage (S3-compatible / MinIO)
# @type=url @sensitive=false
S3_ENDPOINT=if(
  forEnv(development, test), http://localhost:9000,
  undefined
)
# Optional host-facing endpoint for presigned URLs (defaults to S3_ENDPOINT)
# @type=url @sensitive=false @optional
S3_PUBLIC_ENDPOINT=
# @type=string @sensitive=false
S3_REGION=us-east-1

# @type=string
S3_ACCESS_KEY_ID=if(
  forEnv(development, test), minioadmin,
  undefined
)
# @type=string
S3_SECRET_ACCESS_KEY=if(
  forEnv(development, test), minioadmin,
  undefined
)
# @type=string @sensitive=false
S3_BUCKET=assets

# @type=boolean @optional
S3_FORCE_PATH_STYLE=true

# Asset delivery
# @type=number @optional
ASSET_MAX_UPLOAD_BYTES=52428800

# Hosted HTML documents
# @type=number @optional
DOCUMENT_MAX_HTML_BYTES=524288

# Public base URL used in asset.url / markdown responses
# @type=url @sensitive=false
PUBLIC_ASSET_BASE_URL=$BACKEND_URL

# LOKI
# @type=url @optional
LOKI_HOST=
