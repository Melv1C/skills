{
  "name": "backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:migrate": "APP_ENV=development prisma migrate deploy",
    "dev": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen",
    "env:validate": "varlock load",
    "prisma:format": "APP_ENV=development prisma format",
    "prisma:generate": "APP_ENV=development prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "APP_ENV=development prisma validate",
    "start": "bun run db:migrate && bun run src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@better-auth/api-key": "^1.6.27",
    "@better-auth/prisma-adapter": "^1.6.27",
    "@hono/prometheus": "^1.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/studio-core": "^0.33.0",
    "better-auth": "^1.6.27",
    "dotenv": "^17.4.2",
    "hono": "^4.13.1",
    "pg": "^8.23.0",
    "ulid": "^3.0.2",
    "varlock": "^1.16.1",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "prisma-zod-generator": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
